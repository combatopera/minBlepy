author = Andrzej Cichocki and contributors
author_email = 3613868+combatopera@users.noreply.github.com
build requires +=
    Cython==$(cython_build_version)
    numpy==$(numpy_build_version)
buildbot enabled = true
github account = combatopera
internal_module +=
    minBlepy.paste
    minBlepy.paste_turbo
    minBlepy.warmup
name = minBlepy
pypi account = combatopera
requires +=
    lagoon>=21
    numpy>=$(numpy_build_version)
    pyrbo>=13
tagline = MinBLEPs library including fast naive waveform conversion
test requires += Cython==$(cython_build_version)
warmups += minBlepy.warmup:warmup
years +=
    2014
    2020
